# Copy to .env for local development, and set the same values in
# Vercel → Project → Settings → Environment Variables for production.
#
# Use .env, not .env.local: `vercel dev` reads .env. (`vercel env pull` writes
# .env.local, which the npm scripts also read — both files are gitignored.)
#
# DATABASE_URL and BLOB_READ_WRITE_TOKEN are set for you in the cloud once you
# attach the storage, and `vercel dev` downloads them automatically. You only
# need them here for scripts such as `npm run db:seed`.

# Neon Postgres connection string (Vercel → Storage → Create Database → Neon)
DATABASE_URL=

# Vercel Blob store token (Vercel → Storage → Create Store → Blob)
BLOB_READ_WRITE_TOKEN=

# Password for signing in at /admin
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Razorpay key id + secret (Dashboard → Settings → API Keys). Leave both blank
# to keep online payment disabled — checkout still works, it falls back to
# WhatsApp ordering instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Separate secret for the webhook endpoint (Dashboard → Settings → Webhooks →
# add https://<your-domain>/api/webhooks/razorpay, subscribe to "payment.captured"
# and "payment.failed").
RAZORPAY_WEBHOOK_SECRET=

# Secret used to sign customer account session cookies (phone + password
# sign-in at /account) — separate from ADMIN_SESSION_SECRET on purpose, so the
# two never share a trust boundary. Generate one the same way:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CUSTOMER_SESSION_SECRET=
